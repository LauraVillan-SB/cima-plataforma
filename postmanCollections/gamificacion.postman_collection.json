{
  "info": {
    "name": "CIMA - Gamificacion (reconocimientos)",
    "description": "Consulta de reconocimientos del Gamification Service (Tarea 17.2, Req 19.7, 19.8). El otorgamiento no se expone por HTTP (lo invoca el Learning Service dentro del backend), por lo que esta coleccion solo cubre la consulta. Ver postmanCollections/README.md para la configuracion local. No usar credenciales reales.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000" },
    { "key": "telefono", "value": "" },
    { "key": "clave", "value": "" },
    { "key": "otroPerfilId", "value": "22222222-2222-4222-8222-222222222222" }
  ],
  "item": [
    {
      "name": "0. Ingreso (obtiene la cookie de sesion)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"telefono\": \"{{telefono}}\",\n  \"clave\": \"{{clave}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/ingreso",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "auth", "ingreso"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Ingreso exitoso (200)', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('Se establecio la cookie de sesion', function () {",
              "  pm.expect(pm.cookies.has('cima_access')).to.be.true;",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "1. Mis reconocimientos (GET)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/gamificacion/reconocimientos",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "gamificacion", "reconocimientos"]
        },
        "description": "Lista las insignias y el total de puntos del Usuario autenticado. Un Perfil sin reconocimientos recibe una lista vacia y 0 puntos."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 200', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "pm.test('Estructura esperada, sin id de Perfil ni PII', function () {",
              "  pm.expect(body).to.have.all.keys('badges', 'total_points');",
              "});",
              "pm.test('Insignias con codigo y nombre', function () {",
              "  body.badges.forEach(function (b) {",
              "    pm.expect(b).to.have.all.keys('badge_code', 'badge_name');",
              "  });",
              "  pm.expect(body.total_points).to.be.a('number');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Rechazo: reconocimientos de otro Perfil (GET)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/gamificacion/reconocimientos?perfil_id={{otroPerfilId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "gamificacion", "reconocimientos"],
          "query": [{ "key": "perfil_id", "value": "{{otroPerfilId}}" }]
        },
        "description": "Pedir el Perfil de otro Usuario se rechaza con 403 antes de consultar la base de datos, sin revelar si ese Perfil existe (Req 19.8)."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Rechaza con 403', function () { pm.response.to.have.status(403); });",
              "pm.test('No revela insignias ni puntos', function () {",
              "  const body = pm.response.json();",
              "  pm.expect(body).to.not.have.property('badges');",
              "  pm.expect(body).to.not.have.property('total_points');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Rechazo: perfil_id con formato invalido (GET)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/gamificacion/reconocimientos?perfil_id=no-es-un-uuid",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "gamificacion", "reconocimientos"],
          "query": [{ "key": "perfil_id", "value": "no-es-un-uuid" }]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Rechaza con 422', function () { pm.response.to.have.status(422); });"
            ]
          }
        }
      ]
    },
    {
      "name": "4. (Manual) Rechazo: sin sesion (GET)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/gamificacion/reconocimientos",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "gamificacion", "reconocimientos"]
        },
        "description": "Ejecutar a mano DESPUES de borrar las cookies del dominio en Postman (Cookies > localhost > Delete all). Sin cookie de sesion el acceso se rechaza con 403. Si todavia hay sesion en el cookie jar, la prueba se omite."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.cookies.has('cima_access')) {",
              "  pm.test.skip('Omitida: aun hay sesion en el cookie jar');",
              "} else {",
              "  pm.test('Sin sesion responde 403', function () { pm.response.to.have.status(403); });",
              "}"
            ]
          }
        }
      ]
    }
  ]
}
