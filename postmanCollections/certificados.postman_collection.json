{
  "info": {
    "name": "CIMA - Certificados (emitir y consultar)",
    "description": "Certification Service (Tarea 15, Req 6): emision de certificados condicionada e idempotente y consulta con autorizacion por titular. Emitir exige ruta completa y evaluacion aprobada (Req 6.1, 6.2). Completa rutaId con una ruta que el usuario de prueba ya completo y aprobo; rutaSinCompletarId (opcional) con una que no. La solicitud 1 guarda certificadoId automaticamente. Ver postmanCollections/README.md para la configuracion local. No usar credenciales reales.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000" },
    { "key": "telefono", "value": "" },
    { "key": "clave", "value": "" },
    { "key": "rutaId", "value": "" },
    { "key": "rutaSinCompletarId", "value": "" },
    { "key": "certificadoId", "value": "" }
  ],
  "item": [
    {
      "name": "0. Ingreso (obtiene la cookie de sesion)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"telefono\": \"{{telefono}}\",\n  \"clave\": \"{{clave}}\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/v1/auth/ingreso", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "ingreso"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Ingreso exitoso (200)', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('Se establecio la cookie de sesion', function () {",
              "  pm.expect(pm.cookies.has('cima_access')).to.be.true;",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "1. Emitir el certificado de la ruta (POST)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"path_id\": \"{{rutaId}}\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/v1/certificados", "host": ["{{baseUrl}}"], "path": ["api", "v1", "certificados"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 201', function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "const body = pm.response.json();",
              "pm.collectionVariables.set('certificadoId', body.id);",
              "pm.test('El codigo es alfanumerico de 16 a 64 caracteres (Req 6.3)', function () {",
              "  pm.expect(body.verification_code).to.match(/^[A-Za-z0-9]{16,64}$/);",
              "});",
              "pm.test('La fecha de emision es ISO-8601 (Req 6.3)', function () {",
              "  pm.expect(new Date(body.issued_at).toString()).to.not.equal('Invalid Date');",
              "});",
              "pm.test('No expone el identificador del titular', function () {",
              "  pm.expect(body).to.not.have.property('profile_id');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Emitir otra vez: devuelve el mismo certificado (POST, idempotente)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"path_id\": \"{{rutaId}}\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/v1/certificados", "host": ["{{baseUrl}}"], "path": ["api", "v1", "certificados"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Devuelve el certificado existente, sin crear otro (Req 6.4)', function () {",
              "  pm.response.to.have.status(201);",
              "  pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('certificadoId'));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Consultar mi certificado (GET)",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/v1/certificados/{{certificadoId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "certificados", "{{certificadoId}}"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('El titular puede consultarlo (200, Req 6.5)', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('certificadoId'));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Rechazo: certificado inexistente (GET)",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/v1/certificados/{{$guid}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "certificados", "{{$guid}}"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 404 sin filtrar datos de otros Perfiles (Req 6.6)', function () {",
              "  pm.response.to.have.status(404);",
              "  pm.expect(pm.response.json()).to.not.have.property('verification_code');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Rechazo: el titular no se envia en el cuerpo (POST)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"path_id\": \"{{rutaId}}\",\n  \"profile_id\": \"{{$guid}}\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/v1/certificados", "host": ["{{baseUrl}}"], "path": ["api", "v1", "certificados"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Rechaza el profile_id del cliente (422): el titular sale de la sesion (anti-BOLA)', function () {",
              "  pm.response.to.have.status(422);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "6. (Manual) Rechazo: ruta sin completar o sin evaluacion aprobada (POST)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"path_id\": \"{{rutaSinCompletarId}}\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/v1/certificados", "host": ["{{baseUrl}}"], "path": ["api", "v1", "certificados"] },
        "description": "Requiere rutaSinCompletarId: una ruta que el usuario de prueba no completo o cuya evaluacion no aprobo."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('No se emite el certificado (422, Req 6.1, 6.2)', function () {",
              "  pm.response.to.have.status(422);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "7. (Manual) Rechazo: certificado de otro titular (GET)",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/v1/certificados/{{certificadoId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "certificados", "{{certificadoId}}"] },
        "description": "Ingresa con OTRO usuario de prueba (solicitud 0 con otro telefono y clave) y ejecuta esta solicitud con el certificadoId del primer usuario."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Un no titular recibe error de autorizacion (403, Req 6.7)', function () {",
              "  pm.response.to.have.status(403);",
              "  pm.expect(pm.response.json()).to.not.have.property('verification_code');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "8. (Manual) Rechazo: sin sesion (GET)",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/v1/certificados/{{certificadoId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "certificados", "{{certificadoId}}"] },
        "description": "Borra las cookies de localhost en Postman (Cookies > Manage Cookies) y ejecuta esta solicitud."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Sin sesion se rechaza con 403', function () {",
              "  pm.response.to.have.status(403);",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
