# ===== Configuración del backend CIMA (ejemplo, SIN secretos reales) =====
# Copia este archivo a .env y completa los valores. NUNCA subas .env al repositorio.

# Entorno: dev | stage | prod
APP_ENV=dev

# Base de datos PostgreSQL (usar rol con privilegios mínimos, nunca root en prod)
DATABASE_URL=postgresql+asyncpg://cima_app:CHANGE_ME@localhost:5432/cima

# Seguridad / sesión (los secretos reales se gestionan vía Secret Manager en stage/prod)
JWT_ISSUER=https://idp.segurosbolivar.com
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600
SESSION_INACTIVITY_SECONDS=1800
# Secreto de firma de los tokens de sesión. NUNCA uses el valor de dev en stage/prod:
# allí se inyecta desde Secret Manager. Genera uno aleatorio largo para local.
SESSION_SECRET=dev-only-insecure-change-me
# En local (HTTP) puede ser false; en stage/prod DEBE ser true.
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# Allowlist de dominios para consumo externo (SSRF) separada por comas
HTTP_ALLOWLIST_DOMAINS=sostenibilidadbolivar.com

# Servicio de logging centralizado
LOG_LEVEL=INFO

# ===== Modelo del Agente Conversacional (Tarea 11.4) =====
# respaldo = respuesta segura sin llamadas externas (por defecto) | gemini
CHAT_LLM_PROVIDER=respaldo
# API key de Gemini: solo aquí en local; en stage/prod se inyecta desde Secret
# Manager. NUNCA en el código, en frontend/.env ni como variable global del sistema.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_OUTPUT_TOKENS=1024
# Razonamiento previo del modelo: low (por defecto, ~3 s) | high | none (no lo envía)
GEMINI_THINKING_LEVEL=low
# Transcripción de Notas de Voz: respaldo (por defecto, siempre pide repetir) | gemini
# Usa la misma GEMINI_API_KEY y la misma allowlist.
CHAT_STT_PROVIDER=respaldo
GEMINI_STT_MODEL=gemini-3.5-flash-lite
GEMINI_STT_THINKING_LEVEL=none
# Para usar Gemini, su dominio debe estar en la allowlist de SSRF:
# HTTP_ALLOWLIST_DOMAINS=sostenibilidadbolivar.com,generativelanguage.googleapis.com
