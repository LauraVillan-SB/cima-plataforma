# ===== Configuración del backend CIMA (ejemplo, SIN secretos reales) =====
# Copia este archivo a .env y completa los valores. NUNCA subas .env al repositorio.

# Entorno: dev | stage | prod
APP_ENV=dev

# Base de datos PostgreSQL (usar rol con privilegios mínimos, nunca root en prod)
DATABASE_URL=postgresql+asyncpg://cima_app:CHANGE_ME@localhost:5432/cima

# Seguridad / sesión (los secretos reales se gestionan vía Secret Manager en stage/prod)
JWT_ISSUER=https://idp.segurosbolivar.com
ACCESS_TOKEN_TTL_SECONDS=900
SESSION_INACTIVITY_SECONDS=1800

# Allowlist de dominios para consumo externo (SSRF) separada por comas
HTTP_ALLOWLIST_DOMAINS=sostenibilidadbolivar.com

# Servicio de logging centralizado
LOG_LEVEL=INFO
