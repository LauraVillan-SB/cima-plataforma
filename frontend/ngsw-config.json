{
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": ["/favicon.ico", "/index.html", "/manifest.webmanifest", "/*.css", "/*.js"]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/assets/**", "/*.(svg|png|jpg|jpeg|webp|woff2)"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "aprendizaje-offline",
      "urls": [
        "/api/v1/aprendizaje/microcapsulas",
        "/api/v1/aprendizaje/rutas/",
        "/api/v1/evaluaciones/"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 50,
        "maxAge": "30d",
        "timeout": "3s"
      }
    },
    {
      "name": "conversacion-offline",
      "urls": ["/api/v1/chat/historial"],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 1,
        "maxAge": "7d",
        "timeout": "3s"
      }
    }
  ]
}
