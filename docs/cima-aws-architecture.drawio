  <diagram id="cima-login" name="CIMA - Login (Auth Service)">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="ltitle" value="CIMA - Flujo de Login (autenticacion sin friccion: telefono + Clave 4 digitos)" style="text;html=1;fontSize=16;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1000" height="30" as="geometry" />
        </mxCell>
        <mxCell id="lsub" value="CIMA gestiona su propia autenticacion. La Clave se guarda solo como hash; sesion e intentos en Redis." style="text;html=1;fontSize=12;fontStyle=2;align=left;verticalAlign=middle;fontColor=#879196;" vertex="1" parent="1">
          <mxGeometry x="40" y="48" width="1000" height="20" as="geometry" />
        </mxCell>

        <mxCell id="luser" value="Usuario&#10;(PWA movil)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3E;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.user;" vertex="1" parent="1">
          <mxGeometry x="60" y="330" width="60" height="60" as="geometry" />
        </mxCell>

        <mxCell id="lgw" value="API Gateway&#10;(TLS + rate limit)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.api_gateway;" vertex="1" parent="1">
          <mxGeometry x="240" y="330" width="60" height="60" as="geometry" />
        </mxCell>

        <mxCell id="lauth" value="Auth Service&#10;(ECS Fargate)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.fargate;" vertex="1" parent="1">
          <mxGeometry x="440" y="330" width="60" height="60" as="geometry" />
        </mxCell>

        <mxCell id="lredis" value="ElastiCache (Redis)&#10;sesion + intentos&#10;+ bloqueo (TTL)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#2E27AD;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.elasticache;" vertex="1" parent="1">
          <mxGeometry x="680" y="180" width="60" height="60" as="geometry" />
        </mxCell>

        <mxCell id="lrds" value="RDS PostgreSQL&#10;perfil + clave_hash" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#2E27AD;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.rds;" vertex="1" parent="1">
          <mxGeometry x="680" y="330" width="60" height="60" as="geometry" />
        </mxCell>

        <mxCell id="lsm" value="Secrets Manager&#10;clave de firma de tokens" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.secrets_manager;" vertex="1" parent="1">
          <mxGeometry x="680" y="480" width="60" height="60" as="geometry" />
        </mxCell>

        <mxCell id="le1" value="1. telefono + Clave (HTTPS)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="luser" target="lgw"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="le2" value="2. /api/v1/auth/ingreso" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="lgw" target="lauth"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="le3" value="3. revisa intentos / bloqueo" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="lauth" target="lredis"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="le4" value="4. lee clave_hash" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="lauth" target="lrds"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="le5" value="5. clave de firma" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;dashed=1;" edge="1" parent="1" source="lauth" target="lsm"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="le6" value="6. OK: cookie Secure/HttpOnly/SameSite (token corto + refresh)&#10;FALLO: error generico + incrementa contador" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="lauth" target="luser"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="lnotes" value="Reglas (Requirement 1):&#10;- Clave guardada SOLO como hash (bcrypt/argon2); se comparan hashes, nunca texto plano.&#10;- Bloqueo anti fuerza bruta: 5 intentos fallidos lleva a 15 min (contador y bloqueo en Redis con TTL).&#10;- Sesion: token de acceso corto (max 15 min) + refresh rotatorio, en cookie Secure + HttpOnly + SameSite (nunca localStorage).&#10;- Error generico ante Clave incorrecta: no revela si el telefono existe.&#10;- Texto de ayuda (ultimos 4 digitos de la cedula): solo UI; no se valida ni almacena la cedula." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#879196;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="470" width="560" height="150" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
